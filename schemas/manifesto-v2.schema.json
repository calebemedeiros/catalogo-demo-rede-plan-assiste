{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calebemedeiros.github.io/catalogo-demo-rede-plan-assiste/schemas/manifesto-v2.schema.json",
  "title": "Manifesto do catálogo integrado demonstrativo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "generated_at",
    "catalog_url",
    "record_count",
    "source_count",
    "checksum_sha256",
    "authorization"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "environment": { "const": "demo" },
    "generated_at": { "type": "string", "format": "date-time" },
    "catalog_url": { "type": "string", "format": "uri-reference" },
    "record_count": { "type": "integer", "minimum": 0 },
    "source_count": { "type": "integer", "minimum": 1 },
    "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": { "const": "synthetic-demo" },
        "reference": { "type": "null" }
      }
    }
  }
}
