{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calebemedeiros.github.io/catalogo-demo-rede-plan-assiste/schemas/catalogo-v3.schema.json",
  "title": "Catálogo nacional multifonte Plan-Assiste",
  "type": "object",
  "required": ["schema_version", "environment", "generated_at", "authorization", "notices", "sources", "record_count", "records"],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "environment": { "enum": ["demo", "production"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "authorization": { "type": "object" },
    "notices": { "type": "object" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "relationship_label", "coverage_scope", "states", "record_count", "status"]
      }
    },
    "record_count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["public_id", "source_id", "type", "display_name", "specialties", "service_locations", "network_links", "source_updated_at"],
        "properties": {
          "public_id": { "type": "string" },
          "source_id": { "type": "string" },
          "type": { "enum": ["professional", "facility"] },
          "display_name": { "type": "string" },
          "network_links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "relationship_type", "relationship_label", "coverage_scope", "access_mode", "verification_required", "availability_notice"]
            }
          }
        }
      }
    }
  }
}
