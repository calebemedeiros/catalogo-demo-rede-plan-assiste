{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calebemedeiros.github.io/catalogo-demo-rede-plan-assiste/schemas/catalogo-v2.schema.json",
  "title": "Catálogo integrado de prestadores — demonstração",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "generated_at",
    "source",
    "authorization",
    "sources",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "environment": { "const": "demo" },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "source": { "$ref": "#/$defs/catalogSource" },
    "authorization": { "$ref": "#/$defs/authorization" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceDefinition" }
    },
    "record_count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "catalogSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "public_url", "plan_id", "plan_name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "public_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "plan_id": { "type": ["integer", "null"], "minimum": 1 },
        "plan_name": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": { "const": "synthetic-demo" },
        "reference": { "type": "null" }
      }
    },
    "sourceDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "status", "record_count"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{3,80}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "kind": { "type": "string", "enum": ["partner-network", "direct-network", "facility-network", "other"] },
        "status": { "const": "synthetic-demo" },
        "record_count": { "type": "integer", "minimum": 0 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_id",
        "source_id",
        "type",
        "display_name",
        "professional_registry",
        "specialties",
        "service_locations",
        "source_updated_at"
      ],
      "properties": {
        "public_id": { "type": "string", "pattern": "^[a-z0-9-]{8,100}$" },
        "source_id": { "type": "string", "pattern": "^[a-z0-9-]{3,80}$" },
        "type": { "type": "string", "enum": ["professional", "facility"] },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "professional_registry": {
          "oneOf": [
            { "$ref": "#/$defs/professionalRegistry" },
            { "type": "null" }
          ]
        },
        "specialties": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/specialty" }
        },
        "service_locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/serviceLocation" }
        },
        "source_updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "professionalRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["council", "state", "number"],
      "properties": {
        "council": { "type": "string", "minLength": 2, "maxLength": 20 },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "number": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "specialty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rqe"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "rqe": { "type": ["string", "null"], "maxLength": 40 }
      }
    },
    "serviceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facility_public_id", "facility_name", "phones", "address"],
      "properties": {
        "facility_public_id": { "type": ["string", "null"], "maxLength": 100 },
        "facility_name": { "type": ["string", "null"], "maxLength": 200 },
        "phones": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 8, "maxLength": 30 }
        },
        "address": { "$ref": "#/$defs/address" }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "district", "city", "state"],
      "properties": {
        "street": { "type": ["string", "null"], "maxLength": 260 },
        "district": { "type": ["string", "null"], "maxLength": 140 },
        "city": { "type": ["string", "null"], "maxLength": 140 },
        "state": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" }
      }
    }
  }
}
